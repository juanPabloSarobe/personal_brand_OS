# Clave maestra de cifrado de credenciales (32 bytes hex).
# Generar con: openssl rand -hex 32
MASTER_KEY=

# Generar con: openssl rand -hex 32 — secreto compartido entre n8n y core-api para la ruta publica de invitaciones
INTERNAL_API_SECRET=

# Bootstrap del usuario administrador (tu chat ID de Telegram).
# Se obtiene en el Plan B con el bot; por ahora cualquier número sirve para probar.
ADMIN_CHAT_ID=
ADMIN_NAME=

# IA (Plan B1) — crear la key gratis en console.groq.com
GROQ_API_KEY=

# Zona horaria para "Mañana 9hs" (minutos vs UTC; Argentina = -180, España = -60, UTC = 0)
TZ_OFFSET_MINUTES=-180

# Override opcional de modelos por tarea (JSON). Ejemplo:
# AI_ROUTES_JSON={"redactar":{"model":"qwen/qwen3-32b"}}
AI_ROUTES_JSON=

# Publicacion automatica (Plan D)
# 1 = simula publicaciones sin llamar APIs reales (para probar el flujo completo sin publicar)
DRY_RUN=

# URL publica que sirva /data/media (necesaria para que Instagram publique fotos
# automaticamente; sin ella, Instagram siempre entrega el paquete manual por Telegram)
MEDIA_PUBLIC_BASE_URL=

# Bot de Telegram (Plan B2) — crearlo con @BotFather y pegar el token acá
TELEGRAM_BOT_TOKEN=

# Passphrase para cifrar los backups diarios (Plan E). Generar con:
# openssl rand -base64 32
# NUNCA subir el valor real a git ni compartirlo por Telegram/Slack — guardalo
# en un gestor de contraseñas. Sin esta variable, scripts/backup.sh falla.
BACKUP_PASSPHRASE=
