# Clave maestra de cifrado de credenciales (32 bytes hex).
# Generar con: openssl rand -hex 32
MASTER_KEY=

# Bootstrap del usuario administrador (tu chat ID de Telegram).
# Se obtiene en el Plan B con el bot; por ahora cualquier número sirve para probar.
ADMIN_CHAT_ID=
ADMIN_NAME=

# IA (Plan B1) — crear la key gratis en console.groq.com
GROQ_API_KEY=

# Zona horaria para "Mañana 9hs" (minutos vs UTC; Argentina = -180, España = -60, UTC = 0)
TZ_OFFSET_MINUTES=-180

# Override opcional de modelos por tarea (JSON). Ejemplo:
# AI_ROUTES_JSON={"redactar":{"model":"qwen/qwen3-32b"}}
AI_ROUTES_JSON=

# Bot de Telegram (Plan B2) — crearlo con @BotFather y pegar el token acá
TELEGRAM_BOT_TOKEN=
